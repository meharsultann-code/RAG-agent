    {
      "parameters": {
        "jsCode": "// 1. Data Source ki nishandehi (Edit Fields se pichla data uthayein)\nconst stateData = $('Edit Fields').item.json; \nconst agentResponse = $('Interview Agent').first().json.output || \"No response\";\nconst userMessage = $('Telegram Trigger').first().json.text || \"\";\n\n// 2. History handle karein\nlet history = [];\ntry {\n    // Pichli history Edit Fields wale data se uthayein\n    history = JSON.parse(stateData.conversationHistory || \"[]\");\n} catch (e) {\n    history = [];\n}\n\n// 3. History update karein\nhistory.push({ role: 'user', content: userMessage });\nhistory.push({ role: 'assistant', content: agentResponse });\n\n// 4. Counting aur Stage logic (Asli Fix yahan hai)\n// Hum stateData se questionNumber nikal rahe hain jo sheet se aya tha\nlet currentCount = parseInt(stateData.questionNumber) || 0;\nlet nextStage = stateData.conversationStage || \"interview\";\n\n// Agar 12 sawal ho jayen ya AI khatam karde\nif (currentCount >= 12 || agentResponse.includes(\"INTERVIEW_COMPLETE\")) {\n    nextStage = \"analysis\";\n}\n\n// 5. Final Output\nreturn {\n    userId: stateData.userId || \"8146446997\",\n    conversationStage: nextStage,\n    questionNumber: currentCount + 1, // Ab ye 4+1 = 5 karega\n    conversationHistory: JSON.stringify(history),\n    lastActive: new Date().toISOString()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1296,
        -940
      ],
